<Project Sdk="Microsoft.NET.Sdk">
  <!-- Paths, framework, shared references and deploying to BepInEx/scripts come from ../Directory.Build.props.
       translations/English.json brings in Shared/Translations.cs and embeds every translations/*.json. -->
  <PropertyGroup>
    <AssemblyName>GoodTidings</AssemblyName>
    <RootNamespace>GoodTidings</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/ServerSettings.cs" Link="Shared/ServerSettings.cs" />
  </ItemGroup>

  <!-- Unity modules Good Tidings needs beyond the references in ../Directory.Build.props -->
  <ItemGroup>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ManagedDir)/UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)/UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
